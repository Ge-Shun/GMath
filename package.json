{
  "name": "gmath-word-addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Word 加载项：可视化编辑并插入原生可编辑公式，替代 MathType。",
  "scripts": {
    "dev-certs": "office-addin-dev-certs install",
    "serve": "node scripts/serve.mjs",
    "sideload:mac": "node scripts/sideload-mac.mjs",
    "sideload:mac:local": "GMATH_TASKPANE=local node scripts/sideload-mac.mjs",
    "validate": "office-addin-manifest validate manifest.xml",
    "test": "node test/render-test.mjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "http-server": "^14.1.1",
    "office-addin-dev-certs": "^1.13.4",
    "office-addin-manifest": "^1.13.4"
  },
  "dependencies": {
    "mathlive": "0.110.0"
  },
  "license": "MIT"
}
